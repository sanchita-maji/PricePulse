# ==============================================================================
# PricePulse Web Application – Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Environment ('production' or 'development')
APP_ENV=production

# Server Port (automatically provided by cloud platforms like Render, Heroku, Railway)
PORT=8501

# Server Bind Address (use 0.0.0.0 for public cloud and container hosting)
HOST=0.0.0.0
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Headless mode (always true for server environments)
STREAMLIT_SERVER_HEADLESS=true

# Security: Cross-Origin Resource Sharing & Cross-Site Request Forgery Protection
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true

# Telemetry: Disable usage stats collection for privacy & performance
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Database Path override (Optional - defaults to backend/data/amazon_analyzer.db)
# Set to /tmp/amazon_analyzer.db on ephemeral serverless platforms if needed
# DATABASE_PATH=backend/data/amazon_analyzer.db
